public class Pattern {
    public static void main(String[] args) {

        int n = 6;

        for (int i = 1; i <= n; i++) {

            int num;

            // Decide starting number
            if (i % 2 == 0) {
                num = 0;
            } else {
                num = 1;
            }

            for (int j = 1; j <= i; j++) {

                System.out.print(num + " ");

                // Toggle between 0 and 1
                if (num == 1) {
                    num = 0;
                } else {
                    num = 1;
                }
            }

            System.out.println();
        }
    }
}
